{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/scripts/hooks/ensure-worktree-mcp.sh\"",
            "timeout": 120,
            "statusMessage": "Linking new worktree's MCP config server"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/scripts/hooks/ensure-worktree-mcp.sh\"",
            "timeout": 120,
            "statusMessage": "Checking worktree MCP config server link"
          }
        ]
      }
    ]
  }
}
