.DS_Store

# Review correspondence is local-only — kept out of git history
# so iteration drafts don't pollute the spec set.
specifications/REVIEW.md
specifications/REVIEW_RESPONSE*.md

# Personal Claude Code overrides — never committed.
.claude/settings.local.json

# F1 zones 2 and 3 — durable state and ephemeral cache.
# Zone 1 (.claude/gan/) is config and stays tracked; do not add it here.
.gan-state/
.gan-cache/

# Run artifacts from the user-level review skills (~/.claude/skills/review-*,
# spec-review-*). Each invocation writes a timestamped subdir; they're local
# scratch, not part of the repo.
.claude/review-runs/
.claude/spec-review-runs/

# R1 toolchain artifacts.
dist/
node_modules/
coverage/
*.tsbuildinfo
