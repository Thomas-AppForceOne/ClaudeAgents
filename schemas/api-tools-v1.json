    "validateFindings": {
      "description": "Run the reproduction gate over an independent-review bundle. Walks `bundle.findings` in order: keeps `kind:\"inspection\"` findings unchanged, and for each `kind:\"command\"` finding executes the `reproductionCommand` under the wrapper's safe-by-default `/bin/sh -c` runner. Drops with `reproduction-unsafe` when the command carries a banned metacharacter that slipped past the schema (defence-in-depth); drops with `reproduction-failed` on a non-zero exit; drops with `reproduction-errored` when the runner throws (signal interruption, spawn failure). Returns the kept-findings bundle plus the ordered drop ledger; the per-severity summary is recomputed from the kept findings.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "bundle": {
            "description": "The reviewer-authored bundle (schema-valid per `schemas/independent-review-v1.json`). The library walks the bundle's discriminator and field shape internally; the boundary asserts only that this is a non-array object.",
            "type": "object"
          }
        },
        "required": [
          "bundle"
        ],
        "type": "object"
      }
    },
