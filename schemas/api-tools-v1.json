              "highestAttemptNumber"
            ],
            "type": "object"
          },
          "ceilings": {
            "additionalProperties": {
              "type": "number"
            },
            "type": "object"
          },
          "evidence": {
            "items": {
              "additionalProperties": true,
              "properties": {
                "attemptNumber": {
                  "type": "number"
                },
                "outputArtifactPath": {
                  "type": "string"
                },
                "summary": {
                  "type": "string"
                }
              },
              "required": [
                "attemptNumber",
                "outputArtifactPath",
                "summary"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "role": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "attemptState",
          "ceilings",
          "evidence",
          "role"
        ],
        "type": "object"
      }
    },
    "checkSprintBudget": {
      "inputSchema": {
        "additionalProperties": false,
