                  "approve",
                  "runWithoutProjectCommands",
                  "cancel"
                ],
                "type": "string"
              }
            },
            "required": [
              "promptVariant",
              "userChoice",
              "contentHash"
            ],
            "type": "object"
          }
        },
        "required": [
          "resolution"
        ],
        "type": "object"
      }
    },
    "buildValidationAbortBody": {
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "error": {
            "additionalProperties": true,
            "properties": {
              "code": {
                "minLength": 1,
