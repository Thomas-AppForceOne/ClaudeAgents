    "relockContract": {
      "description": "Atomic re-lock of the sprint contract after a renegotiation round. The orchestrator writes the audited draft to `newDraftPath`; the tool archives the prior canonical `sprint-{N}-contract.json` to its `.r{k}.json` sibling, atomic-renames the draft onto the canonical filename, and read-modify-writes `progress.json` (status: `negotiating` → `building`, contractRevision incremented by one). The callback the library version accepts is omitted — the wire cannot supply a TS function, so the orchestrator must write the draft itself before invoking the tool.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "newDraftPath": {
            "description": "Absolute path of the audited draft the orchestrator already wrote. Should follow the `sprint-{N}-contract.draft-tmp.<token>.json` convention so a crash leaves identifiable debris.",
            "minLength": 1,
            "type": "string"
          },
          "progressFilePath": {
            "description": "Absolute path to `progress.json`; the tool read-modify-writes it atomically.",
            "minLength": 1,
            "type": "string"
          },
          "runDir": {
            "minLength": 1,
            "pattern": "^.+/[A-Za-z0-9._-]+-[0-9a-f]{12}/runs/[0-9]{8}T[0-9]{6}-[0-9a-f]{4}$",
            "type": "string"
          },
          "sprintNumber": {
