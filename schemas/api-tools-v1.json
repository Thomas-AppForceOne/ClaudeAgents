          },
          "stage": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "stage",
          "code"
        ],
        "type": "object"
      }
    },
    "checkRoleCeiling": {
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "attemptState": {
            "additionalProperties": true,
