{
  "$id": "https://claudeagents.dev/schemas/api-tools-v1.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "description": "draft-07 catalog of F2 tool input schemas. Each entry under `properties` is a plain catalog record whose `inputSchema` is a complete JSON Schema describing that tool's parameters. By argument shape the catalog spans four classes: project-rooted tools take at minimum `projectRoot: string` (except `getApiVersion`, which takes no arguments); run-scoped tools take `runDir` and/or `repoKey`; worktree-scoped tools take `worktreePath` (the docker tools); and pure-data tools take no scope at all — they transform their inputs only (e.g. `buildEvaluatorPlan`, `buildLoopDetectedBody`, `checkRoleCeiling`, `formatHeartbeat`, the `create*Error` builders). See each tool's `inputSchema` for the authoritative shape. Audited against the runtime parameter validators in `src/config-server/index.ts` at v1.0 release per F5 § Parameter-shape consistency; v1.1 introduces a contract test that enforces parity automatically.",
  "properties": {
    "acquireRunLock": {
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "repoKey": {
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._-]+-[0-9a-f]{12}$",
            "type": "string"
          },
          "runId": {
            "minLength": 1,
            "pattern": "^[0-9]{8}T[0-9]{6}-[0-9a-f]{4}$",
            "type": "string"
          }
        },
        "required": [
          "repoKey",
          "runId"
        ],
        "type": "object"
      }
    },
    "aggregateRunSummary": {
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "runDir": {
            "minLength": 1,
            "pattern": "^.+/[A-Za-z0-9._-]+-[0-9a-f]{12}/runs/[0-9]{8}T[0-9]{6}-[0-9a-f]{4}$",
            "type": "string"
          }
        },
        "required": [
          "runDir"
        ],
        "type": "object"
      }
    },
    "appendToModuleState": {
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "duplicatePolicy": {
            "enum": [
              "error",
              "skip",
              "allow"
            ],
            "type": "string"
          },
          "fieldPath": {
            "minLength": 1,
            "type": "string"
          },
          "key": {
            "minLength": 1,
            "type": "string"
          },
          "name": {
            "minLength": 1,
            "type": "string"
          },
          "projectRoot": {
            "minLength": 1,
            "type": "string"
          },
          "value": {}
        },
        "required": [
          "projectRoot",
          "name",
          "key",
          "fieldPath",
          "value"
        ],
        "type": "object"
      }
    },
    "appendToOverlayField": {
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "fieldPath": {
            "minLength": 1,
            "type": "string"
          },
          "projectRoot": {
            "minLength": 1,
            "type": "string"
          },
          "tier": {
            "enum": [
              "default",
              "user",
              "project"
            ],
            "type": "string"
          },
          "value": {}
        },
        "required": [
          "projectRoot",
          "tier",
          "fieldPath",
          "value"
        ],
        "type": "object"
      }
    },
    "appendToStackField": {
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "fieldPath": {
            "minLength": 1,
            "type": "string"
          },
          "name": {
            "minLength": 1,
            "type": "string"
          },
          "projectRoot": {
            "minLength": 1,
            "type": "string"
          },
          "value": {}
        },
        "required": [
          "projectRoot",
          "name",
          "fieldPath",
          "value"
        ],
        "type": "object"
      }
    },
    "buildEvaluatorPlan": {
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "snapshot": {
            "additionalProperties": true,
            "properties": {
              "activeStacks": {
                "items": {
                  "type": "object"
                },
                "type": "array"
              },
              "mergedSplicePoints": {
                "type": "object"
              }
            },
            "required": [
              "activeStacks",
              "mergedSplicePoints"
            ],
            "type": "object"
          },
          "sprintPlan": {
            "additionalProperties": true,
            "properties": {
              "affectedFiles": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "criteria": {
                "items": {
                  "type": "object"
                },
                "type": "array"
              }
            },
            "required": [
              "affectedFiles",
              "criteria"
            ],
            "type": "object"
          },
          "worktreeState": {
            "additionalProperties": true,
            "properties": {
              "fileContents": {
                "type": "object"
              },
              "files": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              }
            },
            "required": [
              "files"
            ],
            "type": "object"
          }
        },
        "required": [
          "snapshot",
          "sprintPlan",
          "worktreeState"
        ],
        "type": "object"
      }
    },
    "buildLoopDetectedBody": {
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "halt": {
            "additionalProperties": true,
            "properties": {
              "attempts": {
                "type": "number"
              },
              "ceiling": {
                "type": "number"
              },
              "evidence": {},
              "reason": {
                "minLength": 1,
                "type": "string"
              },
              "role": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "reason",
              "role",
              "attempts",
              "ceiling",
              "evidence"
            ],
            "type": "object"
          }
        },
        "required": [
          "halt"
        ],
        "type": "object"
      }
    },
    "buildTrustEventBody": {
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "resolution": {
            "additionalProperties": true,
            "properties": {
              "contentHash": {
                "minLength": 1,
                "type": "string"
              },
              "promptVariant": {
                "enum": [
                  "subsequentChange",
                  "initialIntroduction"
                ],
                "type": "string"
              },
              "userChoice": {
                "enum": [
                  "view",
                  "approve",
                  "runWithoutProjectCommands",
                  "cancel"
                ],
                "type": "string"
              }
            },
            "required": [
              "promptVariant",
              "userChoice",
              "contentHash"
            ],
            "type": "object"
          }
        },
        "required": [
          "resolution"
        ],
        "type": "object"
      }
    },
    "buildValidationAbortBody": {
      "description": "Builds a validation-abort body by wrapping an already-caught error OBJECT (with `code`/`message`). Use this when you have the thrown error in hand. To build from an explicit code plus a details bag instead, use `buildValidationAbortFromCode`.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "error": {
            "additionalProperties": true,
            "properties": {
              "code": {
                "minLength": 1,
                "type": "string"
              },
              "field": {
                "type": "string"
              },
              "file": {
                "type": "string"
              },
              "line": {
                "type": "number"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ],
            "type": "object"
          },
          "stage": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "stage",
          "error"
        ],
        "type": "object"
      }
    },
    "buildValidationAbortFromCode": {
      "description": "Builds a validation-abort body from an explicit error CODE plus an optional details bag — no thrown error needed. Use this to raise an abort you are constructing yourself. To wrap an already-caught error object instead, use `buildValidationAbortBody`.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "minLength": 1,
            "type": "string"
          },
          "details": {
            "description": "Optional free-form error-details bag forwarded verbatim to the error factory; no fixed keys, so it stays an open object rather than a pinned shape.",
            "type": "object"
          },
          "stage": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "stage",
          "code"
        ],
        "type": "object"
      }
    },
    "checkRoleCeiling": {
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "attemptState": {
            "additionalProperties": true,
            "properties": {
              "attemptCount": {
                "type": "number"
              },
              "highestAttemptNumber": {
                "type": "number"
              }
            },
            "required": [
              "attemptCount",
              "highestAttemptNumber"
            ],
            "type": "object"
          },
          "ceilings": {
            "additionalProperties": {
              "type": "number"
            },
            "type": "object"
          },
          "evidence": {
            "items": {
              "additionalProperties": true,
              "properties": {
                "attemptNumber": {
                  "type": "number"
                },
                "outputArtifactPath": {
                  "type": "string"
                },
                "summary": {
                  "type": "string"
                }
              },
              "required": [
                "attemptNumber",
                "outputArtifactPath",
                "summary"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "role": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "attemptState",
          "ceilings",
          "evidence",
          "role"
        ],
        "type": "object"
      }
    },
    "checkSprintBudget": {
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "attemptStateByRole": {
            "additionalProperties": {
              "additionalProperties": true,
              "properties": {
                "attemptCount": {
                  "type": "number"
                },
                "highestAttemptNumber": {
                  "type": "number"
                }
              },
              "required": [
                "attemptCount",
                "highestAttemptNumber"
              ],
              "type": "object"
            },
            "type": "object"
          },
          "budget": {
            "type": "number"
          }
        },
        "required": [
          "attemptStateByRole"
        ],
        "type": "object"
      }
    },
