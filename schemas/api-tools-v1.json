              "evidence": {},
              "reason": {
                "minLength": 1,
                "type": "string"
              },
              "role": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "reason",
              "role",
              "attempts",
              "ceiling",
              "evidence"
            ],
            "type": "object"
          },
          "traceDir": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "fields",
          "traceDir"
        ],
        "type": "object"
      }
    },
    "createRunWorkspace": {
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "fromDir": {
            "minLength": 1,
            "type": "string"
          },
          "mainWorktreeRoot": {
            "minLength": 1,
            "type": "string"
          },
          "newWorktree": {
            "type": "boolean"
          },
          "runId": {
            "minLength": 1,
            "type": "string"
          },
          "subject": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "subject",
          "runId"
        ],
        "type": "object"
      }
    },
    "createSprintBudgetError": {
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "fields": {
            "additionalProperties": true,
            "properties": {
              "attempts": {
                "type": "number"
              },
              "ceiling": {
                "type": "number"
              },
              "evidence": {},
              "reason": {
                "minLength": 1,
                "type": "string"
              },
              "role": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "reason",
              "role",
              "attempts",
              "ceiling",
              "evidence"
            ],
            "type": "object"
          },
          "traceDir": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "fields",
          "traceDir"
        ],
        "type": "object"
      }
    },
    "detectEditOscillation": {
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "history": {
            "items": {
              "additionalProperties": true,
              "properties": {
                "fingerprint": {
                  "type": "string"
                },
                "followedRejection": {
                  "type": "boolean"
                }
              },
              "required": [
                "fingerprint",
                "followedRejection"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "oscillationDetection": {
            "type": "number"
          }
        },
        "required": [
          "history"
        ],
        "type": "object"
      }
    },
    "dockerCheckContainerHealth": {
      "description": "BLOCKS while polling the container's HTTP surface until it answers with `expectStatus`, or until `timeoutSeconds` elapses — it is a waiter, not a one-shot probe, and may block for up to `timeoutSeconds`. Resolves with the observed status on success; throws TimeoutError if the budget is exhausted without a match.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "expectStatus": {
            "maximum": 599,
            "minimum": 100,
            "type": "integer"
          },
          "path": {
            "description": "Localhost-relative request path; a single leading '/', no scheme-relative '//', and no control bytes, whitespace, '?', or '#'. Keeps the health probe pinned to the localhost origin.",
            "minLength": 1,
            "pattern": "^/(?!/)[^\\u0000-\\u001f\\u007f ?#]*$",
            "type": "string"
          },
          "port": {
            "maximum": 65535,
            "minimum": 0,
            "type": "integer"
          },
          "timeoutSeconds": {
            "minimum": 0,
            "type": "number"
          }
        },
        "required": [
          "port",
          "path",
          "expectStatus",
          "timeoutSeconds"
        ],
        "type": "object"
      }
    },
    "dockerContainerName": {
      "description": "Derives (computes / gets) the deterministic container name for a worktree. Pure naming function — no Docker call, no I/O; the same `worktreePath` always yields the same name.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "worktreePath": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "worktreePath"
        ],
        "type": "object"
      }
    },
    "dockerDiscoverPort": {
      "inputSchema": {
        "additionalProperties": false,
        "minProperties": 1,
        "properties": {
          "containerPattern": {
            "minLength": 1,
            "type": "string"
          },
          "envVar": {
            "minLength": 1,
            "type": "string"
          },
          "fallbackPort": {
            "maximum": 65535,
            "minimum": 0,
            "type": "integer"
          },
          "worktreePath": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [],
        "type": "object"
      }
    },
    "dockerReleasePort": {
      "inputSchema": {
        "additionalProperties": false,
