              "role",
              "attempts",
              "ceiling",
              "evidence"
            ],
            "type": "object"
          },
          "traceDir": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "fields",
          "traceDir"
        ],
        "type": "object"
      }
    },
    "createLoopDetectedError": {
      "inputSchema": {
        "additionalProperties": false,
