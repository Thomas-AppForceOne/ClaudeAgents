{
  "$id": "https://claudeagents.dev/schemas/api-tools-v1.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "description": "draft-07 catalog of F2 tool input schemas. Each entry under `properties` is a plain catalog record whose `inputSchema` is a complete JSON Schema describing that tool's parameters. The catalog spans two classes of tools: project-rooted tools take at minimum `projectRoot: string` (except `getApiVersion`, which takes no arguments); run-scoped tools introduced by R7 take `runDir` and/or `repoKey` instead of `projectRoot` — see each tool's `inputSchema` for the authoritative shape. Audited against the runtime parameter validators in `src/config-server/index.ts` at v1.0 release per F5 § Parameter-shape consistency; v1.1 introduces a contract test that enforces parity automatically.",
  "properties": {
    "acquireRunLock": {
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "repoKey": {
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._-]+-[0-9a-f]{12}$",
            "type": "string"
          },
          "runId": {
            "minLength": 1,
            "pattern": "^[0-9]{8}T[0-9]{6}-[0-9a-f]{4}$",
            "type": "string"
          }
        },
        "required": [
          "repoKey",
          "runId"
        ],
        "type": "object"
      }
    },
    "aggregateRunSummary": {
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "runDir": {
            "minLength": 1,
            "pattern": "^.+/[A-Za-z0-9._-]+-[0-9a-f]{12}/runs/[0-9]{8}T[0-9]{6}-[0-9a-f]{4}$",
            "type": "string"
          }
        },
        "required": [
          "runDir"
        ],
        "type": "object"
      }
    },
    "appendToModuleState": {
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "duplicatePolicy": {
            "enum": [
              "error",
              "skip",
              "allow"
            ],
            "type": "string"
          },
          "fieldPath": {
            "minLength": 1,
            "type": "string"
          },
          "key": {
            "minLength": 1,
            "type": "string"
          },
          "name": {
            "minLength": 1,
            "type": "string"
          },
          "projectRoot": {
            "minLength": 1,
            "type": "string"
          },
          "value": {}
        },
        "required": [
          "projectRoot",
          "name",
          "key",
          "fieldPath",
          "value"
        ],
        "type": "object"
      }
    },
    "appendToOverlayField": {
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "fieldPath": {
            "minLength": 1,
            "type": "string"
          },
          "projectRoot": {
            "minLength": 1,
            "type": "string"
          },
          "tier": {
            "enum": [
              "default",
              "user",
              "project"
            ],
            "type": "string"
          },
          "value": {}
        },
        "required": [
          "projectRoot",
          "tier",
          "fieldPath",
          "value"
        ],
        "type": "object"
      }
    },
    "appendToStackField": {
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "fieldPath": {
            "minLength": 1,
            "type": "string"
          },
          "name": {
            "minLength": 1,
            "type": "string"
          },
          "projectRoot": {
            "minLength": 1,
            "type": "string"
          },
          "value": {}
        },
        "required": [
          "projectRoot",
          "name",
          "fieldPath",
          "value"
        ],
        "type": "object"
      }
    },
    "buildEvaluatorPlan": {
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "snapshot": {
            "additionalProperties": true,
            "properties": {
              "activeStacks": {
                "items": {
                  "type": "object"
                },
                "type": "array"
              },
              "mergedSplicePoints": {
                "type": "object"
              }
            },
            "required": [
              "activeStacks",
              "mergedSplicePoints"
            ],
            "type": "object"
          },
          "sprintPlan": {
            "additionalProperties": true,
            "properties": {
              "affectedFiles": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "criteria": {
                "items": {
                  "type": "object"
                },
                "type": "array"
              }
            },
            "required": [
              "affectedFiles",
              "criteria"
            ],
            "type": "object"
          },
          "worktreeState": {
            "additionalProperties": true,
            "properties": {
              "fileContents": {
                "type": "object"
              },
              "files": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              }
            },
            "required": [
              "files"
            ],
            "type": "object"
          }
        },
        "required": [
          "snapshot",
          "sprintPlan",
          "worktreeState"
        ],
        "type": "object"
      }
    },
    "buildLoopDetectedBody": {
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "halt": {
            "additionalProperties": true,
            "properties": {
              "attempts": {
                "type": "number"
              },
              "ceiling": {
                "type": "number"
              },
              "evidence": {},
              "reason": {
                "minLength": 1,
                "type": "string"
              },
              "role": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "reason",
              "role",
              "attempts",
              "ceiling",
              "evidence"
            ],
            "type": "object"
          }
        },
        "required": [
          "halt"
        ],
        "type": "object"
      }
    },
    "buildTrustEventBody": {
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "resolution": {
            "additionalProperties": true,
